/**app.wxss**/
/* 全局只放主题变量与 page 骨架，业务样式就近写在页面 / 组件的 wxss 里 */

/*
 * 字体：数字与拉丁字母走 Barlow（汉字在 Barlow 里没有字形，由 sans-serif 兜底）。
 * - Skyline 的 @font-face 只认 ttf；本项目没有后端，字体文件没地方放，所以把子集化
 *   的 ttf 以 base64 内嵌（三档共约 59KB）。生成方式见 assets/fonts/README.md。
 * - 同族三档字重：400 Regular / 500 Medium / 600 SemiBold。500 那份只嵌了数字和价格符号
 *   （阶梯价专用，5KB），要加重的普通文字照旧写 font-weight: 600。
 * - font-family 一律写字面量，不要改回 var(--xxx)：Skyline 对 var() 的解析有已知缺陷，
 *   字体栈走变量时可能整条失效。
 */
/* fonts:begin */
@font-face {
  font-family: "Barlow";
  font-style: normal;
  font-weight: 400;
  src: url("data:font/ttf;base64,");
}

@font-face {
  font-family: "Barlow";
  font-style: normal;
  font-weight: 500;
  src: url("data:font/ttf;base64,");
}

@font-face {
  font-family: "Barlow";
  font-style: normal;
  font-weight: 600;
  src: url("data:font/ttf;base64,");
}

/* fonts:end */

page {
  /* 只写一个字面量栈：拉丁 / 数字落在 Barlow，其余（含汉字）交给系统默认无衬线字体 */
  font-family: "Barlow", sans-serif;
  /* 文字层级 */
  --tf-fg-0: rgba(0, 0, 0, 0.9);
  --tf-fg-1: rgba(0, 0, 0, 0.55);
  --tf-fg-2: rgba(0, 0, 0, 0.35);
  /* 背景与描边 */
  --tf-bg-0: #ffffff;
  --tf-bg-1: #f7f7f8;
  --tf-border: rgba(0, 0, 0, 0.08);
  /* A 股习惯：涨红跌绿 */
  --tf-up: #fa5151;
  --tf-down: #07c160;
  /* 提示与错误 */
  --tf-danger: #fa5151;
  /*
   * 彩色标签用：强调蓝与警示橙（都取微信 WeUI 调色板）。
   * 蓝色单独留一个位置 —— 红绿在本应用里已经是「涨 / 跌」，
   * 中性的强调只能走蓝或橙，否则会被看成行情方向。
   * -bg 是同一个颜色的 12% 淡底，用来做标签底色。
   */
  --tf-link: #10aeff;
  --tf-link-bg: rgba(16, 174, 255, 0.12);
  --tf-warn: #fa9d3b;
  --tf-warn-bg: rgba(250, 157, 59, 0.12);
  --tf-up-bg: rgba(250, 81, 81, 0.12);
  --tf-down-bg: rgba(7, 193, 96, 0.12);
}
