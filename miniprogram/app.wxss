/**app.wxss**/
/* 全局只放主题变量与 page 骨架，业务样式就近写在页面 / 组件的 wxss 里 */
page {
  /* 文字层级 */
  --tf-fg-0: rgba(0, 0, 0, 0.9);
  --tf-fg-1: rgba(0, 0, 0, 0.55);
  --tf-fg-2: rgba(0, 0, 0, 0.35);
  /* 背景与描边 */
  --tf-bg-0: #ffffff;
  --tf-bg-1: #f7f7f8;
  --tf-border: rgba(0, 0, 0, 0.08);
  /* A 股习惯：涨红跌绿 */
  --tf-up: #fa5151;
  --tf-down: #07c160;
  /* 提示与错误 */
  --tf-danger: #fa5151;
  /*
   * 彩色标签用：强调蓝与警示橙（都取微信 WeUI 调色板）。
   * 蓝色单独留一个位置 —— 红绿在本应用里已经是「涨 / 跌」，
   * 中性的强调只能走蓝或橙，否则会被看成行情方向。
   * -bg 是同一个颜色的 12% 淡底，用来做标签底色。
   */
  --tf-link: #10aeff;
  --tf-link-bg: rgba(16, 174, 255, 0.12);
  --tf-warn: #fa9d3b;
  --tf-warn-bg: rgba(250, 157, 59, 0.12);
  --tf-up-bg: rgba(250, 81, 81, 0.12);
  --tf-down-bg: rgba(7, 193, 96, 0.12);
}
