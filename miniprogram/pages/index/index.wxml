<!--index.wxml-->
<!-- 标题交给导航栏居中显示、底色与页面一致：顶部没有白条，页内也没有大标题 -->
<navigation-bar title="挂单价计算" back="{{false}}" color="black" background="#F7F7F8"></navigation-bar>
<scroll-view class="scrollarea" scroll-y type="list">
  <view class="page">
    <!-- 公司条：左边用原生 picker 选公司，右边进公司管理页。
         选中公司后两个价自动带出来；在这里直接改价也会回写到那家公司 -->
    <view class="company-bar">
      <picker
        class="company-picker"
        mode="selector"
        range="{{pickerOptions}}"
        value="{{pickerIndex}}"
        disabled="{{!companies.length}}"
        bind:change="onCompanyChange"
      >
        <view class="company-picker-inner">
          <text class="company-bar-label">公司</text>
          <text class="company-bar-name {{selectedId ? '' : 'company-bar-name--empty'}}">{{companyName || '未添加'}}</text>
        </view>
      </picker>
      <view
        class="company-bar-manage"
        hover-class="company-bar-manage--active"
        bind:tap="onManage"
        aria-role="button"
        aria-label="公司管理"
      >管理</view>
    </view>

    <!-- 参数卡分三层：
         1. 第一行——昨收 / 今开 / 成本 三个价并排，三个都能当幅度基准；
            标题行 = 名字 + 这一价的 1%（谁显示 1%，谁就是幅度基准，所以不需要「基准」标签）
         2. 第二行——最高 / 今收 / 最低 三个小格，都能改、改完回写公司，不参与挂单价计算
         3. 卡底一行——今开较昨收（左）、今收比最高（右）左右排开
         长按哪个价就弹原生弹框问是否改用那个价为基准（避免误触） -->
    <view class="card">
      <view class="param-row">
        <view class="param" bind:longpress="onAskBasisPrevClose">
          <view class="param-head">
            <text class="param-label">昨收</text>
            <tag
              wx:if="{{basis === 'prevClose' && basisPercentAmount}}"
              class="param-scale"
              type="warning"
              label="1%="
              value="{{basisPercentAmount}}"
            />
          </view>
          <input
            class="param-input"
            type="digit"
            value="{{prevClosePrice}}"
            placeholder="0.00"
            placeholder-class="param-placeholder"
            bind:input="onPrevCloseInput"
          />
        </view>
        <view class="param param--divider" bind:longpress="onAskBasisOpen">
          <view class="param-head">
            <text class="param-label">今开</text>
            <tag
              wx:if="{{basis === 'open' && basisPercentAmount}}"
              class="param-scale"
              type="warning"
              label="1%="
              value="{{basisPercentAmount}}"
            />
          </view>
          <input
            class="param-input"
            type="digit"
            value="{{openPrice}}"
            placeholder="0.00"
            placeholder-class="param-placeholder"
            bind:input="onInput"
          />
        </view>
        <view class="param param--divider" bind:longpress="onAskBasisCost">
          <view class="param-head">
            <text class="param-label">成本</text>
            <tag
              wx:if="{{basis === 'cost' && basisPercentAmount}}"
              class="param-scale"
              type="warning"
              label="1%="
              value="{{basisPercentAmount}}"
            />
          </view>
          <input
            class="param-input"
            type="digit"
            value="{{costPrice}}"
            placeholder="0.00"
            placeholder-class="param-placeholder"
            bind:input="onCostInput"
          />
        </view>
      </view>

      <!-- 第二行：最高 / 今收 / 最低 三个小格（左 · 中 · 右），三个数都能直接改，改完自动回写公司；
           各自跟「当前基准」比：高于基准红、低于绿、持平灰（基准是今开就跟今开比，是昨收就跟昨收比）。
           没有公司时也在，第一次改价会自动建一家 -->
      <view class="param-day">
        <view class="param-day-item param-day-item--start">
          <text class="param-day-label">最高</text>
          <input
            class="param-day-input param-day-input--start param-day-input--{{highTone}}"
            type="digit"
            value="{{rangeHigh}}"
            placeholder="--"
            placeholder-class="param-day-placeholder"
            bind:input="onHighInput"
          />
        </view>
        <view class="param-day-item param-day-item--center">
          <text class="param-day-label">今收</text>
          <input
            class="param-day-input param-day-input--center param-day-input--{{closeTone}}"
            type="digit"
            value="{{rangeClose}}"
            placeholder="--"
            placeholder-class="param-day-placeholder"
            bind:input="onCloseInput"
          />
        </view>
        <view class="param-day-item param-day-item--end">
          <text class="param-day-label">最低</text>
          <input
            class="param-day-input param-day-input--end param-day-input--{{lowTone}}"
            type="digit"
            value="{{rangeLow}}"
            placeholder="--"
            placeholder-class="param-day-placeholder"
            bind:input="onLowInput"
          />
        </view>
      </view>

      <!-- 卡底一行：左边今开较昨收、右边今收比最高；两条都没算出来时只剩提示 -->
      <view class="param-foots">
        <view wx:if="{{openVsPrevClose.text || closeVsHigh.text}}" class="param-readout">
          <view wx:if="{{openVsPrevClose.text}}" class="param-pair">
            <text class="param-pair-label">今开较昨收</text>
            <text class="param-pair-value param-pair-value--{{openVsPrevClose.tone}}">{{openVsPrevClose.text}}</text>
          </view>
          <view wx:if="{{closeVsHigh.text}}" class="param-pair">
            <text class="param-pair-label">今收比最高</text>
            <text class="param-pair-value param-pair-value--{{closeVsHigh.tone}}">{{closeVsHigh.text}}</text>
          </view>
        </view>
        <view wx:if="{{showHint}}" class="param-hint">{{companies.length ? '填入昨收与今开，即得每一档挂单价' : '直接填入昨收与今开就能算，会自动建一家公司'}}</view>
      </view>
    </view>

    <view wx:if="{{error}}" class="tip tip--error">{{error}}</view>

    <!-- 阶梯卡：一行一个档位（价格贴外、幅度居中），表头与行同高 -->
    <view class="card ladder">
      <view class="ladder-head">
        <text class="col-down">下浮</text>
        <text class="col-ratio">幅度(%)</text>
        <text class="col-up">上浮</text>
      </view>

      <view class="row" wx:for="{{fixed}}" wx:key="ratioLabel">
        <text class="col-down price">{{item.fall.text}}</text>
        <text class="col-ratio ratio-text">{{item.ratioLabel}}</text>
        <text class="col-up price">{{item.rise.text}}</text>
      </view>

      <!-- 步进行：中间用步进器调幅度；长按这一行可以用滚轮改默认值 -->
      <view class="row" bind:longpress="onDefaultEdit">
        <text class="col-down price">{{current.fall.text}}</text>
        <view class="col-ratio ratio-cell">
          <stepper
            value="{{ratioValue}}"
            min="{{ratioMin}}"
            max="{{ratioMax}}"
            step="{{ratioStep}}"
            bind:change="onRatioChange"
          />
        </view>
        <text class="col-up price">{{current.rise.text}}</text>
      </view>

      <!-- 长按最后一行后展开：用滚轮改默认幅度 -->
      <view wx:if="{{editingDefault}}" class="default-editor">
        <view class="default-title">滚动选择默认幅度（1% ~ 10%）</view>
        <!-- 选中框高度和每一行的行高必须同一个值（都是 34px）：这样数字才会落在两条线正中间 -->
        <picker-view
          class="default-picker"
          indicator-style="height: 34px"
          value="{{wheelValue}}"
          bind:change="onWheelChange"
        >
          <picker-view-column>
            <view class="default-option" wx:for="{{wheelOptions}}" wx:key="*this">{{item}}</view>
          </picker-view-column>
        </picker-view>
        <view class="default-actions">
          <button size="mini" bind:tap="onDefaultCancel">取消</button>
          <button size="mini" type="primary" bind:tap="onDefaultSave">保存</button>
        </view>
      </view>
    </view>
  </view>
</scroll-view>
