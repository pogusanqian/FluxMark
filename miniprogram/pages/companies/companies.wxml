<!--companies.wxml-->
<navigation-bar title="公司管理" back="{{true}}" color="black" background="#F7F7F8"></navigation-bar>
<scroll-view class="scrollarea" scroll-y type="list" scroll-into-view="{{scrollIntoView}}">
  <!-- 点页面任意处收起左滑打开的那一张卡 -->
  <view class="page" bind:tap="onPageTap">
    <!-- 一家公司一张卡：值从页面传下去，改动用事件抛回来（见 components/company-card）。
         卡与卡的间距留给这一层的容器，卡片组件自己不管排版 -->
    <view wx:for="{{companies}}" wx:key="id" id="company-{{item.id}}" class="card-item">
      <company-card
        data-index="{{index}}"
        name="{{item.name}}"
        prev="{{item.prevClose}}"
        cost="{{item.cost}}"
        open="{{item.open}}"
        close="{{item.close}}"
        high="{{item.high}}"
        low="{{item.low}}"
        error="{{rowErrors[index]}}"
        show-clear="{{hasPrices[index]}}"
        revealed="{{openId === item.id}}"
        bind:nameinput="onNameInput"
        bind:priceinput="onPriceInput"
        bind:priceblur="onPriceBlur"
        bind:clear="onClearTap"
        bind:delete="onDeleteTap"
        bind:swipe="onSwipe"
      />
    </view>

    <view wx:if="{{!companies.length}}" class="empty">还没有公司，点下面的「添加公司」开始</view>
  </view>
</scroll-view>

<view class="footer">
  <view
    class="add-button"
    hover-class="add-button--active"
    bind:tap="onAdd"
    aria-role="button"
    aria-label="添加公司"
  >添加公司</view>
</view>
