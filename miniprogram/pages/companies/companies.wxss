/**companies.wxss**/
/*
 * 公司管理页只负责排版：页边距、卡与卡的间距、空态、贴底按钮。
 * 卡片本身（名称、六个价格、左滑删除、清空）在 components/company-card 里，
 * 页面不再碰卡片内部的任何样式。
 * 版式与计算页同一套卡片语言：白底、24rpx 圆角、页边距 32rpx、颜色只取 app.wxss 的调色板。
 */
page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: var(--tf-bg-1);
}

.scrollarea {
  flex: 1;
  overflow-y: hidden;
}

/* 卡片左右各留 32rpx，与计算页的页边距对齐 */
.page {
  padding: 12rpx 32rpx 24rpx;
}

/*
 * 卡与卡之间留 16rpx。间距是列表的事，留在这一层的容器上：
 * 卡片组件自己不管外边距，换到别的页面排版时由那边的容器决定。
 */
.card-item {
  margin-bottom: 16rpx;
}

/* 一家公司都没有时的空态：一张和正文同款的空卡片 */
.empty {
  padding: 88rpx 32rpx;
  background: var(--tf-bg-0);
  border-radius: 24rpx;
  font-size: 26rpx;
  text-align: center;
  color: var(--tf-fg-2);
}

/* 贴底操作条：始终可点，底部让出安全区 */
.footer {
  flex: none;
  padding: 0 32rpx calc(24rpx + env(safe-area-inset-bottom));
}

/* 添加公司：和卡同款的浅按钮（应用里没有实心彩色按钮，这里也保持安静） */
.add-button {
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 24rpx;
  background: var(--tf-bg-0);
  font-size: 30rpx;
  text-align: center;
  color: var(--tf-link);
}

.add-button--active {
  opacity: 0.6;
}
